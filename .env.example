# ============================================================
# AUTONOMOUS AI SALES VOICE AGENT - Environment Configuration
# ============================================================

# NeonDB PostgreSQL Connection URL
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# LLM Configuration (Groq optional fast cloud inference; Ollama local fallback)
LLM_PROVIDER=ollama
GROQ_API_KEY=
# Optional extra keys for automatic rate-limit rotation:
# GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3
GROQ_MODEL=qwen/qwen3.8-27b

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Whisper STT Configuration
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Piper TTS Configuration
PIPER_MODELS_DIR=./models
PIPER_EN_VOICE=en_US-lessac-medium
PIPER_HI_VOICE=en_US-lessac-medium

# RAG Configuration
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RESULTS=5

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=7860
LOG_LEVEL=INFO
MAX_CONVERSATION_HISTORY=20

# Security
RECORDING_CONSENT_REQUIRED=true
DATA_RETENTION_DAYS=90

# 3rd-Party Email API (Resend or Brevo — no mail server required)
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Optional SMTP fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=sales@techvex.com
